{
  "name": "pukeko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --compile --outfile dist/pukeko",
    "build:linux-arm64": "bun build src/index.ts --compile --target bun-linux-arm64 --outfile dist/pukeko-linux-arm64",
    "build:linux-x64": "bun build src/index.ts --compile --target bun-linux-x64 --outfile dist/pukeko-linux-x64",
    "check:format": "oxfmt --check",
    "dev": "bun run --watch src/index.ts --workspace ../workspace",
    "fmt": "oxfmt",
    "start": "bun run src/index.ts --workspace ../workspace",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.290",
    "croner": "^10.0.1",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.72.0",
    "typescript": "^5.9.0"
  }
}
