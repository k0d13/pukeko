# Secrets. Not in the agent's environment, but it can source this file when a command needs them
# Anything else you add here can be referenced from .mcp.json as ${NAME}

# Run `claude setup-token` on the server
CLAUDE_CODE_OAUTH_TOKEN=
DISCORD_TOKEN=
# Only with [github] in pukeko.toml: a classic token with the notifications and repo scopes
GITHUB_TOKEN=
